# Optional unattended first-run bootstrap only. Leave blank for browser setup.
PEKA_BOOTSTRAP_ADMIN_USERNAME=
PEKA_BOOTSTRAP_ADMIN_PASSWORD=
PEKA_SOURCES_PATH=./sources
PEKA_HTTP_PORT=8080
PEKA_LOG_LEVEL=INFO
PEKA_CMDB_MAX_FILE_SIZE_BYTES=52428800
PEKA_CMDB_MAX_ROW_COUNT=100000
PEKA_OPERATIONAL_TOOL_POLL_INTERVAL_SECONDS=2

# Build identity. Use a canonical release version such as 0.3.0 for releases.
PEKA_CONNECTOR_VERSION=0.3.0.dev0
PEKA_BUILD_REVISION=local
PEKA_BUILD_CREATED=unknown
PEKA_BUILD_SOURCE=local
